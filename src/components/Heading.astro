---
import "../styles/global.css";
type Props = {
  title: string;
  subtitle?: string;
};
const { title, subtitle } = Astro.props;
---

<div
  class="max-w-7xl flex flex-col content-start gap-4 px-2 sm:py-10 py-6 w-full"
>
  <h3 class="text-4xl font-bold border-l-8 pl-2 text-left -ml-4">{title}</h3>
  {subtitle && <p class="max-w-[70ch] text-[var(--text)]/90">{subtitle}</p>}
</div>
