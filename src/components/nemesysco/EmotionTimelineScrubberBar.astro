---
import type { TimelineEvent } from "./timelineEvent";

type Props = {
  events: TimelineEvent[];
  progress?: string;
  slot?: string;
};

const { events, progress = "95%" } = Astro.props;
---

<div class="w-full max-w-7xl px-4 pb-20">
  <div
    class="bg-[#01112B] flex items-center pl-8 py-6 gap-4 w-full box-border rounded-xl shadow-xl"
  >
    <button
      class="bg-white text-[#0b1527] border-none rounded-full w-9 h-9 flex items-center justify-center cursor-pointer shrink-0 hover:scale-105 transition-transform"
      aria-label="Play"
    >
      <svg viewBox="0 0 24 24" fill="currentColor" width="18" height="18">
        <path d="M8 5v14l11-7z"></path>
      </svg>
    </button>

    <div class="relative grow h-2.5 flex items-center timeline-track-container">
      <div class="absolute w-full h-full bg-[#8a93a0]"></div>
      <div class="absolute h-full bg-white z-[1]" style={`width: ${progress};`}>
      </div>

      {
        events.map((event, i) => (
          <button
            id={`btn-${i + 1}`}
            popovertarget={`popover-${i + 1}`}
            class="absolute h-3.5 w-1.5 bg-[#f68c24] border-none p-0 cursor-pointer z-[2] transition-all duration-200 hover:scale-y-125 origin-center after:content-[''] after:absolute after:-inset-4"
            style={`left: ${event.position};`}
          />
        ))
      }
    </div>
  </div>
</div>
