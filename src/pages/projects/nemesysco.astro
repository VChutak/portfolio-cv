---
import "..//../styles/global.css";
import ProjectHeader from "..//../components/ProjectHeader.astro";
import Layout from "../../layouts/Layout.astro";
import ContentWithMedia from "../../components/ContentWithMedia.astro";
import Conclusion from "../../components/Conclusion.astro";
import SeeOtherProjects from "../../components/SeeOtherProjects.astro";
import TwoCards from "../../components/TwoCards.astro";
import Heading from "../../components/Heading.astro";
import VideoEmbedWithContent from "../../components/VideoEmbedWithContent.astro";

import Heading3 from "../../components/Heading3.astro";
import FullWidthVideo from "../../components/FullWidthVideo.astro";
import BeforeAfterSlider from "../../components/BeforeAfterSlider.astro";
import FullHeightImage from "../../components/FullHeightImage.astro";
import ContentWithEmbeds from "../../components/ContentWithEmbeds.astro";
import SplitGallery from "../../components/SplitGallery.astro";
import SplitGalleryLottie from "../../components/nemesysco/SplitGalleryLottie..astro";
import ImageLightbox from "../../components/ImageLightbox.astro";
import InterfaceStateScroller from "../../components/nemesysco/InterfaceStateScroller.astro";
import SpatialArchitectureToggle from "../../components/nemesysco/SpatialArchitectureToggle.astro";
import EmotionTimelineList from "../../components/nemesysco/EmotionTimelineList.astro";
import EmotionTimelineScrubberBar from "../../components/nemesysco/EmotionTimelineScrubberBar.astro";
import type { TimelineEvent } from "../../components/timelineEvent";

const emotionTimelineEvents: TimelineEvent[] = [
  {
    time: "0:11",
    prefix: "Subject is quite ",
    highlight: "EMOTIONAL",
    suffix: " about this",
    position: "35%",
  },
  {
    time: "0:18",
    prefix: "Subject seems to be mostly ",
    highlight: "ENERGETIC",
    position: "50%",
  },
  {
    time: "0:29",
    prefix: "Low levels of ",
    highlight: "STRESS",
    position: "79%",
  },
];
---

<Layout
  title="Nemesysco UI/UX design project by Valeri Ciutac"
  className="dark:bg-[#00132F] bg-[#B9CEEE]"
>
  <ProjectHeader
    projectName="Nemesysco"
    projectStack="Figma, JavaScript, After Effects"
    projectFocus="Adjusting UX and Optimizing App Design"
    projectImage="../../projects/nemesysco/Nemesysco-header.webp"
    projectDescription="Nemesysco's app is a unique blend of technology and implementation. The app design needed to be simple and present a ton of information in real time, all while focusing the viewer on the important parts of the app.The challenge was to come up with a progressive disclosure of information and emphasizing different parts of the app at varying intervals."
  />

  <!-- <ContentWithMedia
    imageFirst={false}
    backgroundColor="#ececec"
    imageCellWidth={6}
    contentCellWidth={6}
    contentImage="../../projects/nemesysco/EmotionLogic-diamond.png"
    contentTitle="What is The Emotional Diamond?"
    contentDescription="Nemesysco’s Emotional Diamond, developed in 2012, simplifies the visualization of complex emotional responses detected by the LVA. It consists of 8 key indicators: Energy, Stress, Logic & Confidence, Emotion, Passion, Uneasy, Mental Effort, and Concentration (out of 14 total emotional states). The core idea is that emotions are context-dependent, not inherently good or bad. By analyzing emotional patterns over time, the Emotional Diamond helps reveal deeper personality traits and reactions."
  /> -->

  <Heading
    title="The Problem"
    subtitle="Nemesysco required a desktop interface for their deep-tech voice and emotion analysis software. While the underlying machine learning engine analyzed only audio data, the interface needed to display a synchronized video feed alongside the real-time emotional telemetry. The primary UX challenges were twofold: managing severe cognitive load (ensuring analysts could monitor the subject without missing data updates) and enabling efficient retrospective review (allowing researchers to quickly find critical moments in hours of footage)."
  />

  <VideoEmbedWithContent
    imageCellOrder={1}
    contentCellOrder={2}
    contentOrder={1}
    imageCellWidth={6}
    contentCellWidth={6}
    videoLink=`https://www.youtube.com/embed/Ux33qb-UUyE?si=GI5cn1vyr3D4_u55 width="560" height="315"
    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen
    `
    contentTitle="Barebones UI was lacking features"
    contentDescription="The old interface lacked essential shortcuts to key timeline milestones and offered no immediate, real-time synthesis of the subject's emotional state, causing user fatigue."
  />

  <Heading title="The Process" subtitle="" />

  <div class="max-w-7xl py-20 mx-auto px-6">
    <InterfaceStateScroller
      sectionNumber="1"
      title="Interface State Mapping (Time-Based UX)"
      description="Managing user expectations before and during AI output by establishing clear temporal states. I designed a clear visual progression to dictate exactly what the user sees from standby to full synthesis."
      visualBgColor="#243E64"
      lottieSrc="../../projects/nemesysco/standby.json"
      imageTwoSrc="../../projects/nemesysco/active.webp"
      imageTwoAlt="Active State"
      imageThreeSrc="../../projects/nemesysco/synthesis.webp"
      imageThreeAlt="Synthesis State"
      phaseOneTitle="Phase1: System Calibration"
      phaseOneDescription={`Initially, the core emotional diamond is present but the data rays are silent. Because the AI requires time to calibrate a baseline emotional state, I introduced a continuous "swooping" micro-animation. This provides immediate, critical system feedback—reassuring the analyst that the application is actively processing the audio stream, rather than stalled or frozen, before the real-time data begins.`}
      phaseTwoTitle="Phase 2: Active Analysis"
      phaseTwoDescription='Once audio input is detected, the radar animates in real-time. To allow immediate value assessment without cluttering the interface with numbers, I enhanced the diamond graphic with subtle background gradations, making the 50% threshold line slightly thicker to serve as a quick-reference baseline. This keeps the layout "quiet" while focusing the user&apos;s attention entirely on the live geometry shifts.'
      phaseThreeTitle="Phase 3: Macro-Level Synthesis"
      phaseThreeDescription={`To summarize the subject's overarching mood, a "Current Emotional Style" indicator was integrated above the diamond. Because it updates infrequently—only changing when a macro state shifts—I minimized its visual weight to keep the primary focus on the active radar. Its display is delayed until a baseline is established, ensuring it tracks long-term trends rather than fleeting micro-expressions.`}
    />

    <SpatialArchitectureToggle
      sectionNumber="2"
      title="Spatial Architecture (The Split-Attention Problem)"
      description={`The original system utilized a "Picture-in-Picture" overlay for the LVA data. I analyzed the physical viewing habits of analysts and discovered this layout caused severe cognitive fatigue. I mapped the eye travel (saccades) to prove that a strict side-by-side layout was mathematically required to prevent missed facial micro-expressions.`}
      problemToggleLabel="Original Overlay"
      solutionToggleLabel="My Architecture"
      problemTitle="The Problem: Floating Overlays"
      problemDescription="Forces complex diagonal eye travel and creates visual interference. The moving video behind the chart creates a constant figure-ground conflict for the brain."
      solutionTitle="The Solution: Horizontal Sync"
      solutionDescription="By extracting the data and locking it perfectly adjacent to the video, both streams remain within a clean horizontal foveal field. Visual occlusion is eliminated."
    />

    <Heading3
      isContentFirst={true}
      title="1. Synchronous Interface Architecture"
      subtitle="I designed a specialized split-view desktop layout that paired the video player directly with an adjacent data visualization panel. The goal was to ensure that the emotional telemetry (graphs, timelines, and confidence scores) mapped perfectly to the audio-visual timeline, allowing researchers to contextualize the data in real-time."
    >
      <div slot="media-slot" class="col-span-1 md:col-span-6 rounded-lg">
        <img src="../../projects/nemesysco/wireframe-1.webp" alt="" />
      </div>
    </Heading3>

    <!-- <ContentWithMedia
    imageFirst={false}
    imageCellWidth={8}
    contentCellWidth={4}
    contentImage="../../projects/nemesysco/wireframe-1.webp"
    contentTitle="The Idea"
    contentDescription=`TEST DESCRIPTION`
  /> -->

    <Heading3
      isContentFirst={false}
      title=`2. Diagnosing & Overcoming "Cognitive Tunneling"`
    >
      <div slot="media-slot" class="col-span-1 md:col-span-6 rounded-lg">
        <ImageLightbox
          src="../../projects/nemesysco/heatmap_2.webp"
          alt="Nemesysco UI Heatmap"
        />
      </div>

      <ul>
        <li class="max-w-[70ch] text-[var(--text)]/90 mb-2">
          <strong>The Insight:</strong> User testing revealed analysts fixated so
          heavily on the video that they suffered from inattentional blindness, completely
          missing critical data panel updates.Threshold-triggered micro-interactions
        </li>
        <li class="max-w-[70ch] text-[var(--text)]/90 mb-2">
          <strong>The Solution </strong> Kept the UI "quiet" during baseline states,
          but engineered threshold-triggered micro-interactions.
        </li>
        <li class="max-w-[70ch] text-[var(--text)]/90 mb-2">
          <strong>Attention Hooks:</strong> When the AI hit a ≥89% confidence score,
          the UI deployed high-contrast color shifts and intentional motion to pull
          the user's eyes to the data exactly when it mattered.
        </li>
      </ul>
    </Heading3>

    <!-- <SplitGallery /> -->
    <SplitGalleryLottie />

    <Heading3
      className={`pb-0!`}
      isContentFirst={true}
      centerText={true}
      title="3. Event-Driven Timeline Navigation"
      subtitle="Because deep-tech analysis requires heavy retrospective review, I designed an intelligent playback timeline. Whenever the system detected a significant shift in the subject's mood, the UI automatically plotted an interactive visual marker directly onto the video scrubber. This allowed users to instantly navigate the subject's emotional journey and jump directly to key milestones, rather than manually scrubbing through hours of raw footage."
    >
      <div slot="media-slot" class="w-full col-span-6">
        <EmotionTimelineList
          events={emotionTimelineEvents}
          defaultOpenIndex={2}
        />
      </div>

      <EmotionTimelineScrubberBar
        slot="footer-slot"
        events={emotionTimelineEvents}
        progress="95%"
      />
    </Heading3>

    <FullWidthVideo
      videoLink=`https://player.vimeo.com/video/1206481496?badge=0&autopause=0&player_id=0&app_id=58479`
      additionalText="Simone's interview used only for demonstration purposes"
      color="#ffffff"
    >
      <!-- <div
      style="padding:75% 0 0 0;position:relative; background-color:transparent !important"
    >
      <iframe
        src="https://player.vimeo.com/video/1206481496?badge=0&autopause=0&player_id=0&app_id=58479&muted=1"
        frameborder="0"
        allow="autoplay; fullscreen; picture-in-picture; clipboard-write; encrypted-media; web-share"
        referrerpolicy="strict-origin-when-cross-origin"
        style="position:absolute;top:0;left:0;width:100%;height:100%; background-color:transparent !important;"
        title="Emotional Diamond app design"></iframe>
    </div><script src="https://player.vimeo.com/api/player.js"></script> -->
    </FullWidthVideo>

    <Heading3
      title="4. Designing for Fault Tolerance & Graceful Recovery"
      subtitle="Instead of frustrating hard resets that destroy session data, I engineered a localized error state UI. It features an intuitive reload mechanism to gracefully recover the real-time data stream and keep the analyst's workflow intact."
    />

    <ContentWithMedia
      imageFirst={true}
      imageCellWidth={8}
      contentCellWidth={4}
      imageBgColor="#01112B"
      contentImage="../../projects/nemesysco/DIamond error messages.gif"
      contentTitle="Beyond the Happy Path"
      contentDescription=`To instantly signal a critical error, the standard diamond UI rotates into a universally recognized stop sign. A "Reload" button is embedded directly inside this focal point, placing the recovery action exactly where the user's attention is inherently drawn.`
    />

    <ContentWithEmbeds
      contentDescription="Instead of relying on static mockups, I coded the UI animations directly in JavaScript and CSS so developers could instantly see how things worked under the hood. By contributing straight to our shared codebase, we skipped the traditional handoff and collaborated much more closely to get the feel exactly right."
      contentTitle="Handoff? Hands-on!"
      contentCellWidth={6}
      imageCellWidth={6}
    >
      <div class="flex flex-col gap-2 w-full">
        <div>
          <p
            class="codepen"
            data-theme-id="dark"
            data-height="280"
            data-pen-title="Nemesysco timeline bars"
            data-default-tab="result"
            data-slug-hash="JjzZQEz"
            data-user="ValeryChe3000"
          >
            <span
              >See the Pen <a
                href="https://codepen.io/ValeryChe3000/pen/JjzZQEz"
              >
                Nemesysco timeline bars</a
              > by Valery (<a href="https://codepen.io/ValeryChe3000"
                >@ValeryChe3000</a
              >) on <a href="https://codepen.io">CodePen</a>.</span
            >
          </p>
          <script async src="https://public.codepenassets.com/embed/index.js"
          ></script>
        </div>
        <p
          class="codepen"
          data-theme-id="dark"
          data-height="280"
          data-pen-title="Nemesysco Diamond"
          data-default-tab="result"
          data-slug-hash="xxBzNrp"
          data-user="ValeryChe3000"
        >
          <span
            >See the Pen <a href="https://codepen.io/ValeryChe3000/pen/xxBzNrp">
              Nemesysco Diamond</a
            > by Valery (<a href="https://codepen.io/ValeryChe3000"
              >@ValeryChe3000</a
            >) on <a href="https://codepen.io">CodePen</a>.</span
          >
        </p>
        <script async src="https://public.codepenassets.com/embed/index.js"
        ></script>
        <div></div>
      </div>
    </ContentWithEmbeds>

    <Heading
      title="The Outcome"
      subtitle="I delivered a specialized, research-grade desktop interface that successfully synchronized video playback with complex, audio-derived data visualization. By utilizing research-driven motion design to manage cognitive load and implementing event-driven timeline markers for rapid navigation, the UI actively guides the analyst's attention and transforms raw audio telemetry into actionable, easily navigable insights."
    />

    <SeeOtherProjects
      previousProjectLink="./dimenso"
      nextProjectLink="./bazinga"
      previousProjectTitle="Dimenso"
      nextProjectTitle="Bazinga AI"
    />
  </div>
</Layout>
