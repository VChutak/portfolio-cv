---
import "..//../styles/global.css";
import ProjectScopeSummary from "../../components/ProjectScopeSummary.astro";
import ProjectMetricsGrid from "../../components/ProjectMetricsGrid.astro";
import ProjectHeader from "..//../components/ProjectHeader.astro";
import Layout from "../../layouts/Layout.astro";
import ContentWithMedia from "../../components/ContentWithMedia.astro";
import Conclusion from "../../components/Conclusion.astro";
import SeeOtherProjects from "../../components/SeeOtherProjects.astro";
import FullHeightImage from "../../components/FullHeightImage.astro";
import ContactMe from "../../components/ContactMe.astro";
import FullWidthImage from "../../components/FullWidthImage.astro";
// import FullWidthVideo from "../../components/FullWidthVideo.astro";
import VideoEmbedWithContent from "../../components/VideoEmbedWithContent.astro";
import Heading from "../../components/Heading.astro";
import Heading3 from "../../components/Heading3.astro";
import TwoCards from "../../components/TwoCards.astro";
import ThreeCards from "../../components/ThreeCards.astro";
import { ACTION_QUERY_PARAMS } from "astro:actions";
import ComparisonSlider from "../../components/ComparisonSlider.astro";
import ImageLightbox from "..//..//components/ImageLightbox.astro";
const palette = [
  { weight: "50", hex: "F9F6FE", textColor: "text-slate-900" },
  { weight: "100", hex: "F1EAFD", textColor: "text-slate-900" },
  { weight: "200", hex: "E5D9FB", textColor: "text-slate-900" },
  { weight: "300", hex: "D1BBF7", textColor: "text-slate-900" },
  { weight: "400", hex: "B48FF1", textColor: "text-slate-900" },
  // 500 is intentionally skipped here as it acts as the header
  { weight: "600", hex: "8044D9", textColor: "text-white" },
  { weight: "700", hex: "6B32BE", textColor: "text-white" },
  { weight: "800", hex: "5C2E9B", textColor: "text-white" },
  { weight: "900", hex: "4C267D", textColor: "text-white" },
  { weight: "950", hex: "31105B", textColor: "text-white" },
];
---

<Layout
  title="Dimenso UI and UX design project by Valeri Ciutac"
  className="dark:bg-[#442580] bg-[#FFE0FF]"
>
  <!-- <ProjectScopeSummary /> -->

  <ProjectHeader
    projectName="Dimenso"
    projectFocus="Technical UI Designer / Frontend Developer"
    projectStack="Blazor, Git, Tailwind CSS Methodology, Figma"
    projectImage="../../projects/dimenso/Dimenso-header.webp"
    projectLink="https://dimenso.vercel.app"
    linkDescription="Explore Prototype"
  >
    <span>
      <a href="https://central.dimenso.cz/#central" class="underline"
        >Dimenso Central</a
      > unifies accommodation and catering logistics into one platform. I designed
      and coded the frontend using customized Blazor component libraries, delivering
      a seamless, role-based dashboard for central administration, inventory purchasing,
      and meal management.</span
    >
  </ProjectHeader>

  <Heading
    title="The Problem"
    subtitle="The engineering team behind Dimenso Central-a Brno-based platform unifying catering and accommodation logistics - had built a powerful backend, but needed a frontend interface to match. The core UX challenge was translating highly complex data into a usable dashboard. Administrators required a streamlined tool to oversee central purchasing, nutritional registers, and multi-facility operations without suffering from cognitive overload."
  />

  <ContentWithMedia
    centerText={true}
    imageFirst={true}
    imageCellOrder={1}
    contentCellOrder={2}
    imageCellWidth={8}
    contentCellWidth={4}
    contentTitle="Information Architecture"
    contentDescription="To translate the tripartite ecosystem into a functional product, I mapped a comprehensive Information Architecture. I utilized a nested directory approach to ensure each persona—the Student (Purple), the Hostel Admin (Green), and the Platform Admin (Red)—had isolated, frictionless navigation paths stemming from a unified global entry point."
  >
    <div slot="media-slot">
      <div
        class="flex flex-col gap-8 bg-white p-6 md:p-10 rounded-3xl shadow-xl"
      >
        <div
          class="w-full border-2 border-slate-200 bg-slate-50/50 rounded-2xl p-6 md:p-8 flex flex-col items-center mb-2 relative"
        >
          <span
            class="absolute -top-3 bg-white px-3 text-xs font-bold tracking-widest text-slate-400 uppercase rounded-full border border-slate-200"
          >
            Shared Ecosystem
          </span>

          <div
            class="bg-[#442580] text-white px-8 py-4 rounded-xl shadow-md font-bold text-lg mb-6 z-10 w-full md:w-auto min-w-[240px] text-center"
          >
            Home Page / Global
          </div>

          <div
            class="flex flex-wrap justify-center gap-4 text-sm font-medium w-full"
          >
            <span
              class="bg-white text-slate-700 px-5 py-2.5 rounded-lg border border-slate-200 shadow-sm"
              >Login</span
            >
            <span
              class="bg-white text-slate-700 px-5 py-2.5 rounded-lg border border-slate-200 shadow-sm"
              >Notifications</span
            >
            <span
              class="bg-white text-slate-700 px-5 py-2.5 rounded-lg border border-slate-200 shadow-sm"
              >App Settings</span
            >
          </div>
        </div>

        <div
          class="grid grid-cols-1 lg:grid-cols-3 gap-6 pt-6 border-t border-slate-100"
        >
          <div class="flex flex-col shadow-sm rounded-xl">
            <div
              class="bg-purple-50 border border-purple-200 text-purple-700 px-6 py-4 rounded-t-xl font-bold flex items-center gap-3"
            >
              <svg
                class="w-5 h-5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"
                ></path></svg
              >
              My Profile
            </div>
            <div
              class="bg-white border border-t-0 border-purple-200 rounded-b-xl p-6 flex-grow"
            >
              <ul class="space-y-4 text-slate-700 font-medium text-sm">
                <li>
                  <div
                    class="flex items-center gap-2 mb-2 hover:text-purple-600 transition-colors cursor-default"
                  >
                    Payments History
                  </div>
                  <ul
                    class="border-l-2 border-slate-200 ml-3 pl-4 space-y-2 text-slate-500"
                  >
                    <li
                      class="hover:text-purple-600 transition-colors cursor-default"
                    >
                      Previous Payment
                    </li>
                  </ul>
                </li>

                <li>
                  <div
                    class="flex items-center gap-2 mb-2 hover:text-purple-600 transition-colors cursor-default"
                  >
                    Accommodation History
                  </div>
                  <ul
                    class="border-l-2 border-slate-200 ml-3 pl-4 space-y-2 text-slate-500"
                  >
                    <li
                      class="hover:text-purple-600 transition-colors cursor-default"
                    >
                      Previous Accommodation
                    </li>
                  </ul>
                </li>

                <li>
                  <div
                    class="flex items-center gap-2 mb-2 hover:text-purple-600 transition-colors cursor-default"
                  >
                    Current Booking
                  </div>
                  <ul
                    class="border-l-2 border-slate-200 ml-3 pl-4 space-y-2 text-slate-500"
                  >
                    <li
                      class="hover:text-purple-600 transition-colors cursor-default"
                    >
                      Extend Booking
                    </li>
                    <li
                      class="hover:text-purple-600 transition-colors cursor-default"
                    >
                      Cancel Booking
                    </li>
                    <li
                      class="hover:text-purple-600 transition-colors cursor-default"
                    >
                      Report issue
                    </li>
                  </ul>
                </li>

                <li class="pt-2">
                  <div
                    class="flex items-center gap-2 hover:text-purple-600 transition-colors cursor-default"
                  >
                    Profile Settings
                  </div>
                </li>
              </ul>
            </div>
          </div>

          <div
            class="flex flex-col relative shadow-md rounded-xl transform lg:-translate-y-2 transition-transform"
          >
            <div
              class="absolute inset-0 bg-green-500/5 blur-xl -z-10 rounded-3xl"
            >
            </div>

            <div
              class="bg-green-50 border border-green-200 text-green-700 px-6 py-4 rounded-t-xl font-bold flex justify-between items-center"
            >
              <div class="flex items-center gap-3">
                <svg
                  class="w-5 h-5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  ><path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"
                  ></path></svg
                >
                Uni Dashboard
              </div>
            </div>
            <div
              class="bg-white border border-t-0 border-green-200 rounded-b-xl p-6 flex-grow"
            >
              <ul class="space-y-4 text-slate-700 font-medium text-sm">
                <li>
                  <div
                    class="flex items-center gap-2 hover:text-green-600 transition-colors cursor-default"
                  >
                    General Settings
                  </div>
                </li>

                <li class="pt-2">
                  <div
                    class="flex items-center gap-2 mb-2 hover:text-green-600 transition-colors cursor-default"
                  >
                    Users List
                  </div>
                  <ul
                    class="border-l-2 border-slate-200 ml-3 pl-4 space-y-2 text-slate-500"
                  >
                    <li
                      class="hover:text-green-600 transition-colors cursor-default"
                    >
                      User Details
                    </li>
                  </ul>
                </li>

                <li class="pt-2">
                  <div
                    class="flex items-center gap-2 mb-2 hover:text-green-600 transition-colors cursor-default"
                  >
                    Rooms List
                  </div>
                  <ul
                    class="border-l-2 border-slate-200 ml-3 pl-4 space-y-2 text-slate-500"
                  >
                    <li>
                      <div
                        class="mb-2 hover:text-green-600 transition-colors cursor-default"
                      >
                        Room Details
                      </div>
                      <ul
                        class="border-l-2 border-slate-200 ml-3 pl-4 space-y-2 text-slate-400"
                      >
                        <li
                          class="hover:text-green-600 transition-colors cursor-default"
                        >
                          Issues List
                        </li>
                        <li
                          class="hover:text-green-600 transition-colors cursor-default"
                        >
                          User List (registered)
                        </li>
                      </ul>
                    </li>
                  </ul>
                </li>
              </ul>
            </div>
          </div>

          <div class="flex flex-col shadow-sm rounded-xl">
            <div
              class="bg-red-50 border border-red-200 text-red-700 px-6 py-4 rounded-t-xl font-bold flex items-center gap-3"
            >
              <svg
                class="w-5 h-5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"
                ></path><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path></svg
              >
              Admin Dashboard
            </div>
            <div
              class="bg-white border border-t-0 border-red-200 rounded-b-xl p-6 flex-grow"
            >
              <ul class="space-y-4 text-slate-700 font-medium text-sm">
                <li>
                  <div
                    class="flex items-center gap-2 hover:text-red-600 transition-colors cursor-default"
                  >
                    Backup Service
                  </div>
                </li>

                <li class="pt-2">
                  <div
                    class="flex items-center gap-2 mb-2 hover:text-red-600 transition-colors cursor-default"
                  >
                    Power Apps Configuration
                  </div>
                  <ul
                    class="border-l-2 border-slate-200 ml-3 pl-4 space-y-2 text-slate-500"
                  >
                    <li>
                      <div
                        class="mb-2 hover:text-red-600 transition-colors cursor-default"
                      >
                        Apps List
                      </div>
                      <ul
                        class="border-l-2 border-slate-200 ml-3 pl-4 space-y-2 text-slate-400"
                      >
                        <li
                          class="hover:text-red-600 transition-colors cursor-default"
                        >
                          Add / Remove App
                        </li>
                      </ul>
                    </li>
                  </ul>
                </li>

                <li class="pt-2">
                  <div
                    class="flex items-center gap-2 hover:text-red-600 transition-colors cursor-default"
                  >
                    System Monitor
                  </div>
                </li>

                <li class="pt-2">
                  <div
                    class="flex items-center gap-2 mb-2 hover:text-red-600 transition-colors cursor-default"
                  >
                    Customers List
                  </div>
                  <ul
                    class="border-l-2 border-slate-200 ml-3 pl-4 space-y-2 text-slate-500"
                  >
                    <li>
                      <div
                        class="mb-2 hover:text-red-600 transition-colors cursor-default"
                      >
                        Customer Details
                      </div>
                      <ul
                        class="border-l-2 border-slate-200 ml-3 pl-4 space-y-2 text-slate-400"
                      >
                        <li
                          class="hover:text-red-600 transition-colors cursor-default"
                        >
                          Security Settings
                        </li>
                      </ul>
                    </li>
                  </ul>
                </li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  </ContentWithMedia>

  <div class="max-w-7xl py-20 mx-auto px-4 md:px-0">
    <!-- 12-Column Grid Wrapper -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
      <!-- LEFT COLUMN: Sticky Intro Text (4 Columns) -->
      <div class="lg:col-span-4 lg:sticky lg:top-32">
        <h3 class="text-3xl font-bold text-[--text] mb-4">
          Mapping a Tripartite Ecosystem
        </h3>
        <p class="text-[--text-sub] leading-relaxed text-lg">
          The Dimenso platform required an architecture that could accommodate
          three distinct user archetypes. While I mapped the macro-journeys for
          all three to ensure system-wide cohesion, I ultimately focused my
          deep-dive UX and UI prototyping on the most operationally complex
          experience: <strong>The Hostel Owners</strong>.
        </p>
      </div>

      <!-- RIGHT COLUMN: Stacking Personas (8 Columns) -->
      <!-- Adjusted gaps: gap-12 on mobile (normal stack), gap-40 on desktop (for the sticky overlap) -->
      <div class="lg:col-span-8 flex flex-col gap-12 lg:gap-40 pb-12 lg:pb-32">
        <!-- PERSONA 1: The Student -->
        <!-- Added relative lg:sticky lg:top-24 so it only sticks on desktop -->
        <div
          class="relative lg:sticky lg:top-24 bg-white rounded-3xl shadow-[0_0_40px_rgba(0,0,0,0.08)] p-6 md:p-10 flex flex-col gap-10 z-10 transition-transform"
        >
          <!-- Top Section -->
          <div class="flex flex-col md:flex-row gap-8">
            <div class="w-full md:w-1/3 flex flex-col shrink-0">
              <img
                src="../../projects/dimenso/martina.webp"
                alt="Martina Janíčková"
                class="w-full h-64 md:h-auto md:aspect-[4/5] object-cover rounded-2xl mb-5"
              />
              <div class="flex items-center gap-3">
                <div
                  class="w-10 h-10 rounded-full bg-purple-100 text-purple-600 flex items-center justify-center shrink-0"
                >
                  <svg
                    class="w-6 h-6"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    ><path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"
                    ></path></svg
                  >
                </div>
                <div>
                  <h4 class="text-xl font-bold text-slate-900 leading-tight">
                    Martina Janíčková
                  </h4>
                  <span class="text-slate-500 text-sm">The busy student</span>
                </div>
              </div>
            </div>

            <div class="w-full md:w-2/3 flex flex-col justify-center gap-6">
              <p class="text-xl text-slate-800 leading-relaxed font-medium">
                "Being a student means constantly juggling classes, work, and a
                social life. Some days, it feels impossible to stay on top of
                everything and still have time for myself."
              </p>
              <div>
                <h5 class="text-xl font-bold text-slate-900 mb-2">Bio</h5>
                <p class="text-slate-600 text-base leading-relaxed">
                  Martina juggles classes, work, and social life, relying on
                  Dimenso for quick food orders, last-minute stays, and campus
                  services—all from her phone. Always on the lookout for deals,
                  she shares reviews and tips to help fellow students get the
                  best experience.
                </p>
              </div>
            </div>
          </div>

          <div class="w-full h-px bg-slate-100"></div>

          <!-- Middle Section -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            <div>
              <h5 class="text-xl font-bold text-slate-900 mb-4">Goals</h5>
              <ul
                class="text-slate-600 text-sm space-y-3 list-disc pl-5 marker:text-slate-300"
              >
                <li>Book rooms fast and reliable</li>
                <li>
                  Be on top of everything that is going on in the campus life.
                </li>
              </ul>
            </div>
            <div>
              <h5 class="text-xl font-bold text-slate-900 mb-4">Pains</h5>
              <ul
                class="text-slate-600 text-sm space-y-3 list-disc pl-5 marker:text-slate-300"
              >
                <li>Clunky UIs makes her waste time.</li>
                <li>Misses important events going on campus.</li>
                <li>Has difficulties keeping tabs on every app.</li>
              </ul>
            </div>
          </div>

          <!-- Bottom Section -->
          <div>
            <h5 class="text-xl font-bold text-slate-900 mb-4">Devices</h5>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
              <div
                class="flex flex-col items-center text-center p-4 rounded-xl bg-slate-50"
              >
                <svg
                  class="w-8 h-8 text-slate-800 mb-2"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  ><path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="1.5"
                    d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"
                  ></path></svg
                >
                <span class="text-slate-900 font-bold text-xl mb-1">72%</span>
                <span class="text-xs text-slate-600 leading-snug"
                  >Mostly uses her phone to interact with the platform</span
                >
              </div>
              <div
                class="flex flex-col items-center text-center p-4 rounded-xl bg-slate-50"
              >
                <svg
                  class="w-8 h-8 text-slate-800 mb-2"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  ><rect
                    x="4"
                    y="4"
                    width="16"
                    height="16"
                    rx="2"
                    ry="2"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"></rect><line
                    x1="8"
                    y1="18"
                    x2="16"
                    y2="18"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"></line></svg
                >
                <span class="text-slate-900 font-bold text-xl mb-1">10%</span>
                <span class="text-xs text-slate-600 leading-snug"
                  >Uses her tablet mostly for media consumptio</span
                >
              </div>
              <div
                class="flex flex-col items-center text-center p-4 rounded-xl bg-slate-50"
              >
                <svg
                  class="w-8 h-8 text-slate-800 mb-2"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  ><path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="1.5"
                    d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                  ></path></svg
                >
                <span class="text-slate-900 font-bold text-xl mb-1">18%</span>
                <span class="text-xs text-slate-600 leading-snug"
                  >Uses laptop only when the phone is discharged</span
                >
              </div>
            </div>
          </div>
        </div>

        <!-- PERSONA 2: The Admin -->
        <!-- Added relative lg:sticky lg:top-32 -->
        <div
          class="relative lg:sticky lg:top-32 bg-white rounded-3xl shadow-[0_-10px_40px_rgba(0,0,0,0.1)] p-6 md:p-10 flex flex-col gap-10 z-20 transition-transform"
        >
          <!-- Top Section -->
          <div class="flex flex-col md:flex-row gap-8">
            <div class="w-full md:w-1/3 flex flex-col shrink-0">
              <img
                src="../../projects/dimenso/lukas.webp"
                alt="Lukáš Čáp"
                class="w-full h-64 md:h-auto md:aspect-[4/5] object-cover rounded-2xl mb-5"
              />
              <div class="flex items-center gap-3">
                <div
                  class="w-10 h-10 rounded-full bg-red-50 text-red-600 flex items-center justify-center shrink-0"
                >
                  <svg
                    class="w-6 h-6"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    ><path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M4 6h16M4 12h16M4 18h16M8 6v.01M16 12v.01M8 18v.01"
                    ></path></svg
                  >
                </div>
                <div>
                  <h4 class="text-xl font-bold text-slate-900 leading-tight">
                    Lukáš Čáp
                  </h4>
                  <span class="text-slate-500 text-sm">The almighty Admin</span>
                </div>
              </div>
            </div>

            <div class="w-full md:w-2/3 flex flex-col justify-center gap-6">
              <p class="text-xl text-slate-800 leading-relaxed font-medium">
                "I make sure everything runs smoothly—efficient setups, secure
                systems, and zero friction for users. If there’s a smarter way
                to do it, I’ll find it."
              </p>
              <div>
                <h5 class="text-xl font-bold text-slate-900 mb-2">Bio</h5>
                <p class="text-slate-600 text-base leading-relaxed">
                  Lukáš ensures smooth onboarding and system management as a
                  platform administrator. Tech-savvy and detail-oriented, he
                  configures customer accounts, monitors system performance, and
                  maintains security standards. With a structured and proactive
                  mindset, Lukáš values automation and efficiency, ensuring a
                  seamless experience for users while keeping operations running
                  flawlessly.
                </p>
              </div>
            </div>
          </div>

          <div class="w-full h-px bg-slate-100"></div>

          <!-- Middle Section -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            <div>
