    <div class="flex flex-col gap-4">
      <p>
        The foundational step was completely remapping the flow of information.
        By establishing a strict visual hierarchy, I transformed unstructured,
        overwhelming data into highly scannable product cards—ensuring users
        never feel lost while navigating complex inventory logistics.
      </p>
    </div>
    <script lang="ts">
      let draggedItem = null;

      const pieces = document.querySelectorAll(".draggable-piece");
      pieces.forEach((piece) => {
        piece.addEventListener("dragstart", function (e) {
          draggedItem = this;
          setTimeout(() => this.classList.add("opacity-40", "scale-95"), 0);
          if (e.dataTransfer)
            e.dataTransfer.setData(
              "text/plain",
              this.getAttribute("data-target"),
            );
        });

        piece.addEventListener("dragend", function () {
          this.classList.remove("opacity-40", "scale-95");
          draggedItem = null;
        });
      });

      const dropZones = document.querySelectorAll(".drop-zone");
      dropZones.forEach((zone) => {
        zone.addEventListener("dragover", (e) => e.preventDefault());

        zone.addEventListener("dragenter", function (e) {
          e.preventDefault();
          if (
            draggedItem &&
            this.getAttribute("data-accepts") ===
              draggedItem.getAttribute("data-target")
          ) {
            // Active drop zone styling (change ring color based on your brand)
            this.classList.add("ring-2", "ring-purple-400", "bg-purple-50/50");
          }
        });

        zone.addEventListener("dragleave", function () {
          this.classList.remove("ring-2", "ring-purple-400", "bg-purple-50/50");
        });

        zone.addEventListener("drop", function (e) {
          this.classList.remove("ring-2", "ring-purple-400", "bg-purple-50/50");

          if (
            draggedItem &&
            this.getAttribute("data-accepts") ===
              draggedItem.getAttribute("data-target")
          ) {
            // 1. Get the template ID from the dropped pill
            const templateId = draggedItem.getAttribute("data-template-id");
            const template = document.getElementById(templateId);

            // 2. Clone the HTML content inside the template
            const clonedHTML = template.content.cloneNode(true);

            // 3. Clean up the drop zone borders and layout properties
            this.classList.remove(
              "border-dashed",
              "border-2",
              "border-gray-300",
              "items-center",
              "justify-center",
            );
            this.classList.add("border-transparent"); // Keeps layout stable

            // 4. Inject the HTML components
            this.innerHTML = "";
            this.appendChild(clonedHTML);

            // 5. Hide the dropped pill from the bank
            draggedItem.remove();

            // 6. Lock the zone
            this.removeAttribute("data-accepts");
          }
        });
      });
    </script>

    <style>
