  { weight: "100", hex: "F1EAFD", textColor: "text-slate-900" },
  { weight: "200", hex: "E5D9FB", textColor: "text-slate-900" },
  { weight: "300", hex: "D1BBF7", textColor: "text-slate-900" },
  { weight: "400", hex: "B48FF1", textColor: "text-slate-900" },
  // 500 is intentionally skipped here as it acts as the header
  { weight: "600", hex: "8044D9", textColor: "text-white" },
  { weight: "700", hex: "6B32BE", textColor: "text-white" },
  { weight: "800", hex: "5C2E9B", textColor: "text-white" },
