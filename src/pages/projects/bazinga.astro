---
import "..//../styles/global.css";
import ProjectScopeSummary from "../../components/ProjectScopeSummary.astro";
import ProjectMetricsGrid from "../../components/ProjectMetricsGrid.astro";
import ProjectHeader from "..//../components/ProjectHeader.astro";
import Layout from "../../layouts/Layout.astro";
import ContentWithMedia from "../../components/ContentWithMedia.astro";
import Conclusion from "../../components/Conclusion.astro";
import SeeOtherProjects from "../../components/SeeOtherProjects.astro";
import FullHeightImage from "../../components/FullHeightImage.astro";
import ContactMe from "../../components/ContactMe.astro";
import FullWidthVideo from "../../components/FullWidthVideo.astro";
import VideoEmbedWithContent from "../../components/VideoEmbedWithContent.astro";
import Heading from "../../components/Heading.astro";
import Heading3 from "../../components/Heading3.astro";
import TwoCards from "../../components/TwoCards.astro";
import ThreeCards from "../../components/ThreeCards.astro";
import ImageLightbox from "../../components/ImageLightbox.astro";
import BrandColorPairToggle from "../../components/bazinga/BrandColorPairToggle.astro";
import ColorSwatchGrid from "../../components/bazinga/ColorSwatchGrid.astro";
import FlowStepTimeline from "../../components/bazinga/FlowStepTimeline.astro";
import AnnotatedScreenshot from "../../components/bazinga/AnnotatedScreenshot.astro";
import type {
  ColorSwatch,
  FlowStep,
  Hotspot,
} from "../../components/bazinga/bazingaTypes";

const orangeSwatches: ColorSwatch[] = [
  { label: ".400", hex: "#f56241", textClass: "text-white" },
  { label: ".50", hex: "#fef3ee", textClass: "text-gray-900" },
  { label: ".100", hex: "#fee2d6", textClass: "text-gray-900" },
  { label: ".200", hex: "#fbc2ad", textClass: "text-gray-900" },
  { label: ".300", hex: "#f99878", textClass: "text-white" },
  { label: ".500", hex: "#f23b1d", textClass: "text-white" },
  { label: ".600", hex: "#e32213", textClass: "text-white" },
  { label: ".700", hex: "#bc1612", textClass: "text-white" },
  { label: ".800", hex: "#961618", textClass: "text-white" },
  { label: ".900", hex: "#791516", textClass: "text-white" },
  { label: ".950", hex: "#41090c", textClass: "text-white" },
];

const blueSwatches: ColorSwatch[] = [
  { label: ".400", hex: "#5076f6", textClass: "text-white" },
  { label: ".50", hex: "#eff2ff", textClass: "text-[#5076f6]" },
  { label: ".100", hex: "#dce3fd", textClass: "text-[#5076f6]" },
  { label: ".200", hex: "#c0cefd", textClass: "text-[#5076f6]" },
  { label: ".300", hex: "#95affb", textClass: "text-white" },
  { label: ".500", hex: "#3f5cf2", textClass: "text-white" },
  { label: ".600", hex: "#293ae7", textClass: "text-white" },
  { label: ".700", hex: "#2129d4", textClass: "text-white" },
  { label: ".800", hex: "#2124ac", textClass: "text-white" },
  { label: ".900", hex: "#202488", textClass: "text-white" },
  { label: ".950", hex: "#181953", textClass: "text-white" },
];

const beforeFlowSteps: FlowStep[] = [
  {
    title: "1. Start",
    description: 'Click "Create Assistant" on the dashboard.',
  },
  {
    title: "2. Configure Identity",
    description: "Select an avatar from a text-only dropdown menu.",
    calloutLabel: "UX Pain Point",
    calloutText:
      "Blind selection. Users cannot see what their bot looks like until later.",
  },
  {
    title: "3. Set Parameters",
    description:
      "Navigate a long, uncategorized page of ambiguous sliders.",
    calloutLabel: "UX Pain Point",
    calloutText:
      "Cognitive overload. Sliders lack explicit values or scales, forcing trial-and-error.",
  },
  {
    title: "4. Save & Switch Context",
    description:
      'Save the configuration and navigate away to a separate "Preview" page.',
    calloutLabel: "UX Pain Point",
    calloutText:
      "Broken feedback loop. Every adjustment requires leaving the editor to test.",
  },
];

const afterFlowSteps: FlowStep[] = [
  {
    title: "1. Start",
    description: "Enter the unified Agent Builder workspace.",
  },
  {
    title: "2. Define Appearance",
    description: "Pick from an inline, visual avatar grid.",
    calloutLabel: "UX Win",
    calloutText: "Immediate visual recognition and brand alignment.",
  },
  {
    title: "3. Configure Behavior",
    description:
      "Adjust settings organized into logical tabs, using labeled sliders.",
    calloutLabel: "UX Win",
    calloutText: "Reduced cognitive load. Clear mental models replace guesswork.",
  },
  {
    title: "4. Test in Real-Time",
    description:
      "Interact with the persistent, on-brand chat window alongside settings.",
    calloutLabel: "UX Win",
    calloutText:
      "WYSIWYG feedback loop. Instantly validate changes without context switching.",
  },
];

const newFlowHotspots: Hotspot[] = [
  {
    number: 1,
    top: "25%",
    left: "18%",
    align: "left",
    text: "Predefined Avatars easily selectable and visible from the start",
  },
  {
    number: 3,
    top: "25%",
    left: "75%",
    align: "right",
    text: "Customized chat window to match the Bazinga style as the default theme.",
  },
  {
    number: 2,
    top: "67%",
    left: "50%",
    align: "center",
    text: "Utilizing the UI elements from the component library designed following the marketing design",
  },
];
---

<Layout
  title="Bazinga AI Web design and UI/UX design project by Valeri Ciutac"
  className="dark:bg-[#3A0709] bg-[#FFEBE4]"
>
  <!-- <ProjectScopeSummary /> -->

  <ProjectHeader
    projectName="Bazinga AI"
    projectFocus="Architecting UX. Engineering UI."
    projectStack="Figma, Blazor, Tailwind CSS"
    projectImage="../../projects/bazinga/Bazinga-header.webp"
    projectDescription=`Designed and developed the Bazinga AI platform end-to-end. I built the foundational brand identity and marketing website, then leveraged that design system to architect the core web app—transforming a complex AI assistant configuration process into an intuitive, seamless user flow.`
    projectLink="https://bazinga.ai/"
    linkDescription="Live site"
  />
  <!-- <FullHeightImage
    backgroundColor="#c9371e"
    image="../../projects/bazinga/bazinga-full-website.webp"
  /> -->
  <Heading
    title="The Problem"
    subtitle="Building a custom AI assistant is often an overwhelming, highly technical process that alienates non-developer users. Furthermore, many AI startups suffer from fragmented user journeys where the marketing site looks completely disconnected from the actual software. Bazinga AI needed a unified, intuitive experience that guided users seamlessly from discovering the product to successfully configuring and deploying their own AI agents."
  />

  <Heading title="The Process" subtitle="" />

  <Heading3
    title="1. Visual Identity & Design System Foundation"
    subtitle="Before touching the complex application logic, I established the core brand language. I developed the logo and brand book, but rather than treating them as static graphic assets, I immediately translated them into a scalable UI design system. By defining global design tokens (typography, color variables, spacing), I ensured visual consistency across every future touchpoint."
  />

  <ContentWithMedia
    color="#1a1a1a"
    centerText={true}
    imageFirst={true}
    imageBgColor="#ffffff"
    backgroundColor="#fef3ee"
    imageCellOrder={1}
    contentCellOrder={2}
    imageCellWidth={6}
    contentCellWidth={6}
    contentImage="../../projects/bazinga/bazinga-brand0.webp"
    contentTitle="It all starts with a logo"
    contentDescription="A strong logo is simple, memorable, and versatile, ensuring it resonates with the audience across various platforms and mediums. Bazinga's logo represents a stylized chat bubble and the instantly recognizable AI magic star"
  />

  <ContentWithMedia
    centerText={true}
    imageFirst={false}
    imageCellOrder={1}
    contentCellOrder={2}
    imageCellWidth={6}
    contentCellWidth={6}
    contentTitle="Base element for the brand identity"
    contentDescription=`All graphic elements are derived from the logo’s shapes, creating a unified and recognizable design across all materials. This ensures that every visual detail—whether it’s icons, buttons, or backgrounds—feels intentional and aligned with the brand’s identity. By maintaining this consistency, the brand becomes more visually cohesive, reinforcing trust and recognition while making the user experience feel polished and seamless.`
  >
    <div slot="media-slot">
      <ImageLightbox src="../../projects/bazinga/bazinga-brand99.webp" />
    </div>
  </ContentWithMedia>

  <!-- <FullHeightImage
    backgroundColor="#fef3ee"
    text="Using the logo as the baseline, I derived a cohesive and memorable styleguide"
  > -->

  <ContentWithMedia
    centerText={true}
    imageFirst={true}
    imageCellWidth={8}
    imageCellOrder={1}
    contentCellOrder={2}
    contentCellWidth={4}
    contentTitle="Color"
    contentDescription=`I carefully crafted a color palette centered around orange and blue to make the brand feel more approachable, especially for non-tech audiences. Orange conveys energy, warmth, and creativity, while blue adds a sense of trust and professionalism—striking a perfect balance between innovation and reliability.

Starting with these core colors, I systematically expanded the palette, ensuring harmony and consistency. `
  >
    <div slot="media-slot">
      <BrandColorPairToggle
        orangeRgb="245 98 65"
        orangeCmyk="0 60 73 4"
        orangeHex="#f56241"
        orangeMobileImage="../../projects/bazinga/bazinga-color-orange-desktop.webp"
        orangeDesktopImage="../../projects/bazinga/bazinga-color-orange-mobile.webp"
        blueRgb="80 118 246"
        blueCmyk="67 52 0 4"
        blueHex="#5076F6"
        blueMobileImage="../../projects/bazinga/bazinga-color-blue-desktop.webp"
        blueDesktopImage="../../projects/bazinga/bazinga-color-blue-mobile.webp"
      />
    </div>
  </ContentWithMedia>

  <ContentWithMedia
    centerText={true}
    imageFirst={true}
    imageCellWidth={8}
    contentCellWidth={4}
    imageCellOrder={1}
    contentCellOrder={2}
    contentTitle="Tailwind CSS Palette"
    contentDescription=`From the initial shades, I derived a comprehensive Tailwind CSS color system, defining variations for backgrounds, text, buttons, and accents. This approach provided scalability and flexibility, allowing for a visually cohesive experience across the entire platform while maintaining accessibility and contrast.`
  >
    <div slot="media-slot">
      <ColorSwatchGrid groups={[orangeSwatches, blueSwatches]} />
    </div>
  </ContentWithMedia>

  <!-- <TwoCards
    imageOne="../../projects/bazinga/bazinga_sparks.gif"
    imageTwo="../../projects/bazinga/bazinga_chatbubbles.gif"
    cardOneTitle="Animated elements"
    cardTwoTitle="Expanding the style guide to UI"
    cardOneDescription=""
    cardTwoDescription=""
  /> -->

  <!-- <ThreeCards
    imageOne="../../projects/bazinga/bazinga_sparks.gif"
    imageTwo="../../projects/bazinga/bazinga_sparks.gif"
    imageThree="../../projects/bazinga/bazinga_sparks.gif"
    titleOne="Animated elements"
    titleTwo="Animated elements"
    titleThree="Animated elements"
    descriptionOne="Expanding the style guide to UI"
    descriptionTwo="Expanding the style guide to UI"
    descriptionThree="Expanding the style guide to UI"
  /> -->

  <ContentWithMedia
    imageCellOrder={1}
    contentCellOrder={2}
    centerText={true}
    imageFirst={false}
    imageCellWidth={8}
    contentCellWidth={4}
    contentTitle="Expanding the style to UI elements"
    contentDescription="A major advantage of being both the brand designer and the UI/UX designer is the ability to create truly distinctive and cohesive user interfaces. This ensures that every element not only aligns seamlessly with the brand’s identity but also feels intentional, polished, and visually unique. By maintaining full creative control over both branding and UI/UX, I can design experiences that are not just functional, but also aesthetically compelling and instantly recognizable—giving the product a powerful competitive edge."
  >
    <div slot="media-slot">
      <ImageLightbox src="../../projects/bazinga/bazinga-pricing.webp" alt="" />
    </div>
  </ContentWithMedia>

  <Heading3
    title="2. Marketing UI & Conversion Flow"
    subtitle="With the design system in place, I designed the top-of-funnel web experience. The goal here was not just visual appeal, but conversion architecture—crafting clear messaging, intuitive navigation, and strategic calls-to-action designed to funnel visitors smoothly into the application's onboarding flow."
  />

  <FullHeightImage>
    <ImageLightbox
      src="../projects/bazinga/bazinga-full-website.webp"
      alt="bazinga homepage design"
    />
  </FullHeightImage>
  <Heading3
    title="3. The Agent Creation Flow (Core UI/UX)"
    subtitle="Restructured the application's information hierarchy to create an intuitive AI builder, translating deep technical complexity into a clear, user-centric interface"
  />

  <ContentWithMedia
    imageFirst={false}
    imageCellWidth={6}
    contentCellWidth={6}
    contentTitle="The Assistant Creation Flow"
    contentDescription=`The original assistant creation flow suffered from fragmented information architecture and high interaction friction. Disconnected settings, ambiguous controls, and an off-brand preview created a confusing and tedious setup experience.`
  >
    <div slot="media-slot">
      <ImageLightbox
        src="../../projects/bazinga/bazinga_flow1.webp"
        alt="bazinga assistant ui before redesign"
      />
    </div>
  </ContentWithMedia>

  <FlowStepTimeline
    heading={`The "Before" Flow: High Friction`}
    steps={beforeFlowSteps}
    variant="warning"
  />

  <ContentWithMedia
    imageFirst={true}
    imageCellWidth={8}
    contentCellWidth={4}
    contentTitle="The NEW Flow"
    contentDescription=``
  >
    <div slot="media-slot">
      <AnnotatedScreenshot
        src="../../projects/bazinga/bazinga-assistant-flow.webp"
        alt="bazinga ui before redesign"
        hotspots={newFlowHotspots}
      />
    </div>

    <div>
      <ul>
        <li class="max-w-[70ch] text-[var(--text)]/90 mb-2">
          <p>
            <strong>Consolidated Architecture:</strong> Grouped related settings into
            distinct, logical categories (e.g., Appearance, Behavior), reducing cognitive
            load and making navigation effortless.
          </p>
        </li>
        <li class="max-w-[70ch] text-[var(--text)]/90 mb-2">
          <p>
            <strong>Visual Avatar Selection</strong>Replaced the clunky dropdown
            with an inline, visual avatar picker, allowing users to see and
            select their choices instantly. Precise
          </p>
        </li>

        <li class="max-w-[70ch] text-[var(--text)]/90 mb-2">
          <p>
            <strong>Configuration Controls</strong> Upgraded the sliders with explicit
            labels, values, and meaningful scales, eliminating guesswork and trial-and-error.
            High-Fidelity,
          </p>
        </li>
        <li class="max-w-[70ch] text-[var(--text)]/90 mb-2">
          <p>
            <strong>On-Brand Preview:</strong> Injected Bazinga AI’s core visual identity
            into the live chat window, creating a true WYSIWYG (What You See Is What
            You Get) feedback loop so users know exactly what they are building.
          </p>
        </li>
      </ul>
    </div>
  </ContentWithMedia>

  <FlowStepTimeline
    heading={`The "After" Flow: Streamlined WYSIWYG Experience`}
    steps={afterFlowSteps}
    variant="success"
  />

  <!-- <FullHeightImage
    backgroundColor="#111A38"
    image="../../projects/bazinga/bazinga-brand2.webp"
  /> -->

  <!-- <ProjectMetricsGrid /> -->

  <!-- <VideoEmbedWithContent
        videoLink=`https://player.vimeo.com/video/1054267122?title=0&amp;controls=0&amp;badge=0&amp;autopause=0&amp;autoplay=1&loop=1&amp;player_id=0&amp;app_id=58479" frameborder="0" allow="autoplay; fullscreen; picture-in-picture; clipboard-write; encrypted-media; controls=0; sidedock=0; title=0` 
        videoFirst={true}
        contentDescription="TESSSSSST"
        contentTitle="TESSSSSST"
        imageCellWidth={6}
        contentCellWidth={6}
        /> -->
  <Heading
    title="Conclusion"
    subtitle="I delivered a fully interactive, end-to-end Figma prototype and a comprehensive component library. By owning the process from the foundational branding all the way through to the complex application logic, I eliminated the typical friction between marketing and product design. The result was a cohesive, dev-ready system that allowed the engineering team to begin frontend implementation immediately without needing to guess at interaction states or design rules."
  />

  <!-- <FullHeightImage
  backgroundColor="#ffffff00"
  image="../../projects/bazinga/bazinga_loader.gif"
/> -->

  <ContactMe />
  <SeeOtherProjects
    previousProjectLink="./nemesysco"
    nextProjectLink="./dimenso"
    previousProjectTitle="Nemesysco"
    nextProjectTitle="Dimenso"
  />
</Layout>
